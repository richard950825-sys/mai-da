# Server-side configuration (never publish this populated file). Keep the populated .env.local private (chmod 600).
MCD_MCP_TOKEN=
DEEPSEEK_API_KEY=
PORT=8798
ALLOW_LOCAL_ENV_CREDENTIALS=true
ALLOW_PROVIDER_ACCESS=true
ALLOW_CONFIRMED_ORDERS=false
# Only enable after explicitly authorizing user-confirmed real orders.
MCD_ORDER_TERMS_URL=https://www.mcdonalds.com.cn/page/McDonalds-Internet-Site-Terms-and-Conditions/
MCD_CANCELLATION_DISCLOSURE="餐厅接单并开始制作后，不能变更餐厅、修改或取消订单。请在官方支付页再次核对，取消与退款以官方条款和订单状态为准。"

# Optional local product-catalog file; default is data/catalog.sqlite.
MCD_CATALOG_DB=

# Visitors enter their own McDonald's token. The owner MCD_MCP_TOKEN is ignored in this mode.
# DEEPSEEK_API_KEY above remains server-only and is shared under the IP allowance.
PUBLIC_ACCESS=true
# Set this to the exact HTTPS site origin when publishing; no trailing slash.
PUBLIC_ORIGIN=
# Enable only behind a local Cloudflare Tunnel; keep the backend on 127.0.0.1.
TRUST_CLOUDFLARE_PROXY=false
# Persistent allowance: 10 AI requests per IP, reset at midnight Asia/Shanghai.
MCD_QUOTA_DB=
