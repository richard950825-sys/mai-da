{
  "name": "mai-da",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vpc_services": [
    {
      "binding": "MCD_API",
      "service_id": "01a12519-9c16-7253-addc-b1c989cd5a97"
    }
  ],
  "observability": {
    "enabled": false
  }
}
